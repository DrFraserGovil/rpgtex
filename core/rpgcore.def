\ExplSyntaxOff

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Package Dependencies
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Helps prevent option clash with other packages that include xcolor
\PassOptionsToPackage {table} {xcolor}

\RequirePackage {array}						% Array operations 
\RequirePackage {enumitem}					% Manipulate lists
\RequirePackage {hang}						% hanging paragraphs
\RequirePackage {tabularx}					% variable-width table columns
\RequirePackage {xltabular}					% breakable tables
\RequirePackage {supertabular}				% long tables
\RequirePackage [breakable,skins,xparse]{tcolorbox} % styled text boxes
\RequirePackage {tikz}						% drawing ornaments and lines
\RequirePackage {xcolor}					% Nice colo(u)rs
\RequirePackage [titles] {tocloft}			% multi-column toc
\RequirePackage [newparttoc] {titlesec}		% Used to adjust (sub)section, part, and table of contents formatting
\RequirePackage{titletoc}					%% Title manipulation
\RequirePackage{fancyhdr}					%% For headers and footers
\RequirePackage{float}						%% Better floats
\RequirePackage{dblfloatfix}				%% Float fixes for twocolumn environments
\RequirePackage{cuted}						%% For \strip environment
\RequirePackage {xparse}					% expl3 programming layer

%% Might be needed later, so leave commented
% \RequirePackage {etoolbox}					% Tools like \At
% \RequirePackage[hidelinks] {hyperref}

\usetikzlibrary{calc}
\ExplSyntaxOn

\sys_if_engine_luatex:T
{
	\RequirePackage {luacolor}
}


\NewDocumentCommand \RpgThemeLayoutOnly { +m }
{
	\bool_if:NT \__rpg_IsClass
	{
		#1
	}
}

%% force layout changes -- but only if layout option triggered by class
\RpgThemeLayoutOnly{
	\RequirePackage {microtype} % Improve ragged2e hyphenation and overfull boxes
	\RequirePackage {ragged2e}

	\bool_if:NT \__rpg_HasMulticolToc
	{ \RequirePackage [toc] {multitoc} }




	% Restrict hyphenation
	\tolerance        = 1
	\emergencystretch = \maxdimen
	\hyphenpenalty    = 10000
	\hbadness         = 10000

	% Set left justification if not justified
	\bool_if:NF \__rpg_IsJustified
	{ \RaggedRight }

	% Customize itemize environment.
	\setlist{leftmargin=1em}
	\setitemize{noitemsep,topsep=0.5ex,label=\footnotesize{\textbullet}}
}

% % % Load other modules of this package after all dependencies to avoid load order
% % % conflicts (e.g., package options).
% % % Low-level modules first.

\input {core/modules/	themes			.rpg-code.tex}
\input {core/modules/	colors			.rpg-code.tex}
\input {core/modules/	dice			.rpg-code.tex}
\input {core/modules/	lengths			.rpg-code.tex}
\input {core/modules/	text_utility	.rpg-code.tex}
\input {core/modules/	fonts/fonts		.rpg-code.tex}
\input {core/modules/	paper			.rpg-code.tex}
\input {core/modules/	images			.rpg-code.tex}
\input {core/modules/	sections		.rpg-code.tex}
\input {core/modules/	parts			.rpg-code.tex}
\input {core/modules/	titles			.rpg-code.tex}

\input {core/environments/	callouts		.rpg-code.tex}
\input {core/environments/	filigree		.rpg-code.tex}
\input {core/environments/	table			.rpg-code.tex}
\input {core/environments/	abstract		.rpg-code.tex}
\input {core/environments/	map				.rpg-code.tex}
