\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Class / Package options
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage {l3keys2e} %key/value parsing



% These booleans are not set directly by an option (i.e. instead set by .code)
\bool_new:N		\__rpg_ShowBackground
\bool_new:N		\__rpg_ShowFooterScroll
\bool_new:N		\__rpg_IsJustified
\bool_new:N		\__rpg_HasMulticolToc
\bool_new:N		\__rpg_OneSide
\bool_new:N		\__rpg_OpenRight
\tl_new:N		\__rpg_FontSize
\tl_new:N		\__rpg_PageColumns

\bool_set_false:N \__rpg_OneSide
\bool_set_false:N \__rpg_OpenRight
\bool_set_true:N \__rpg_HasMulticolToc

%% Theme Values
\tl_new:N		\__rpg_Theme
\tl_new:N		\__rpg_ThemePath
\bool_new:N		\__rpg_ThemePathModified
\bool_set_false:N \__rpg_ThemePathModified

\bool_new:N \l__rpg_layout_bool
\bool_set_eq:NN \l__rpg_layout_bool \c__rpg_isclass_bool

\RequirePackage{core/theme_engine} %%need this for theme path switching


% Note that there is no 'unknown value' handling -- rpgtex passes *all* keys to the parent class first.
% Standard latex classes fail silently if they don't recognise an option, so I reason it's fine for me to do that too.
\keys_define:nn { rpg / options }
{
	% Large-scale styling choice
	bg .choice:,
	bg / full .code:n =
		{
			\bool_set_true:N \__rpg_ShowBackground
			\bool_set_true:N \__rpg_ShowFooterScroll
		},
	bg / print .code:n =
		{
			\bool_set_false:N \__rpg_ShowBackground
			\bool_set_true:N \__rpg_ShowFooterScroll
		},
	bg / none .code:n =
		{
			\bool_set_false:N \__rpg_ShowBackground
			\bool_set_false:N \__rpg_ShowFooterScroll
		},
	bg .initial:n = full,

	% Justified text
	justified .code:n =
		{
			\bool_set_true:N \__rpg_IsJustified
		},
	justified .value_forbidden:n = true,

	% Disable multi-column toc
	nomultitoc .code:n =
		{
			\bool_set_false:N \__rpg_HasMulticolToc
		},
	nomultitoc .value_forbidden:n = true,

	% Theme selection
	theme .code:n =
		{
			\tl_set:Nn \__rpg_Theme { #1 }
		},
	theme .initial:n = default,
	theme .value_required = true,

	% Theme Path modification
	themepath .code:n 	={
			\tl_set:Nn \__rpg_ThemePath{ #1 }
			\bool_set_true:N \__rpg_ThemePathModified
		},
	themepath .value_required:n = true,

	% Font size
	size .code:n = {
			\tl_set:Nn \__rpg_FontSize { #1 }
		},
	size .default:n = { 10pt },
	size .value_required=true,

	% Columns
	columns .choice:,
	columns / 1 .code:n = {
			\tl_set:Ne \__rpg_PageColumns { onecolumn }
		},
	columns / 1 .code:n = {
			\tl_set:Ne \__rpg_PageColumns { twocolumn }
		},
	columns .initial:n = 2,

	%Use openany
	openright .code:n =
		{
			\bool_set_true:N \__rpg_OpenRight
		},
	openright .value_forbidden:n = false,

	%Set one-sided
	oneside .code:n = {
			\bool_set_true:N \__rpg_OneSide
		},
	oneside .value_forbidden:n = true,

}

% Set the values provided in the file
\ProcessKeysOptions { rpg / options }

%then override with command line if present
\ifcsname\RpgCMD\endcsname
	\keys_set:nV {rpg/options}{\RpgCMD}
\fi




%then insert the saved arguments into the parent class
\bool_if:NT \c__rpg_isclass_bool
{

	\PassOptionsToClass{ \tl_use:N \l__rpg_font_size_tl }{\g__rpg_base_class_tl }
	\PassOptionsToClass{ \tl_use:N \l__rpg_cols_tl }{ \g__rpg_base_class_tl }

	\bool_if:NTF \l__rpg_openright_bool
	{
		\PassOptionsToClass{ openright }{\g__rpg_base_class_tl }
	}
	{
		\PassOptionsToClass{ openany }{\g__rpg_base_class_tl }
	}
	\bool_if:NT \l__rpg_oneside_bool
	{
		\PassOptionsToClass{ oneside }{\g__rpg_base_class_tl }
	}
}


