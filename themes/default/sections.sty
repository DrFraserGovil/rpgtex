%% filigree

\RpgThemeSetFiligree{
	\foreach \m in {0.2,0.6,1,1.4}
		{
			\draw[thin] ($(frame.north~west)+(0,-{\m*\__rpg_filigreeSize})$) to[out=60,in=-150] ($(frame.north~west)+({\m*\__rpg_filigreeSize},0)$);
			\draw[thin] ($(frame.south~west)+(0,{\m*\__rpg_filigreeSize})$)  to[out=60,in=-150]($(frame.south~west)+({\m*\__rpg_filigreeSize},0)$);
			\draw[thin] ($(frame.north~east)+(0,-{\m*\__rpg_filigreeSize})$)  to[out=60,in=-150] ($(frame.north~east)+({-\m*\__rpg_filigreeSize},0)$);
			\draw[thin] ($(frame.south~east)+(0,{\m*\__rpg_filigreeSize})$) to[out=-120,in=30]($(frame.south~east)+({-\m*\__rpg_filigreeSize},0)$);

		}
}
\ExplSyntaxOn
\tcbset{
rpg filigree/. append~style={
top=2pt,
left=2pt,
right=2pt,
}
}
\ExplSyntaxOff
